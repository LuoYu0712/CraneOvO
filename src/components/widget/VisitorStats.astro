---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;

const statCards = [
	{
		icon: "material-symbols:today-outline-rounded",
		label: i18n(I18nKey.visitorStatsTodayViews),
		id: "busuanzi_today_pv",
	},
	{
		icon: "material-symbols:person-outline-rounded",
		label: i18n(I18nKey.visitorStatsTodayVisitors),
		id: "busuanzi_today_uv",
	},
	{
		icon: "material-symbols:bar-chart-outline-rounded",
		label: i18n(I18nKey.visitorStatsTotalViews),
		id: "busuanzi_site_pv",
	},
	{
		icon: "material-symbols:group-outline-rounded",
		label: i18n(I18nKey.visitorStatsTotalVisitors),
		id: "busuanzi_site_uv",
	},
];
---

<WidgetLayout
  name={i18n(I18nKey.visitorStats)}
  showTitle={showTitle}
  id="visitor-stats"
  class={className}
  style={style}
>
  <div class="flex flex-col gap-2">
    <div class="grid grid-cols-2 gap-2">
      {statCards.map((item) => (
        <div class="rounded-xl border border-neutral-200/70 bg-neutral-50/70 px-3 py-3 dark:border-neutral-700/70 dark:bg-neutral-800/60">
          <div class="flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
            <Icon is:inline name={item.icon} class="text-base text-(--primary)" />
            <span>{item.label}</span>
          </div>
          <div class="mt-2 text-lg font-semibold text-neutral-900 dark:text-neutral-100">
            <span id={item.id} class="visitor-stat-value">--</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</WidgetLayout>

<script is:inline defer src="//cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js"></script>

<script is:inline>
  const refreshVisitorStats = () => {
    const values = document.querySelectorAll('.visitor-stat-value');
    values.forEach((element) => {
      if (element.textContent?.trim() === '--') {
        element.textContent = '加载中...';
      }
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(refreshVisitorStats, 1200);
  });

  document.addEventListener('astro:page-load', () => {
    setTimeout(refreshVisitorStats, 1200);
  });
</script>
